cabal-version:       3.0
name:                taffybar-exe
version:             0.1.0.0
author:              Deep Majumder
maintainer:          deep.majumder2019@gmail.com
build-type:          Simple

executable taffybar-exe
  hs-source-dirs:      .
  main-is:             taffybar.hs
  ghc-options:         -threaded -rtsopts -with-rtsopts=-N
  build-depends:       base ^>=4.19.2.0
                     , taffybar>=7.0.1.2
                     , process
                     , text
                     , text-conversions
                     , data-default
  default-language:    Haskell2010
