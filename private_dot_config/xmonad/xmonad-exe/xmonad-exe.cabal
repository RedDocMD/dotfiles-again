cabal-version:      3.0
name:               xmonad-exe
version:            0.1.0.0
-- synopsis:
-- description:
license:            BSD-3-Clause
license-file:       LICENSE
author:             Deep Majumder
maintainer:         deep.majumder2019@gmail.com
-- copyright:
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

executable xmonad-exe
    import:           warnings
    main-is:          xmonad.hs
    -- other-modules:
    -- other-extensions:
    build-depends:
        base ^>=4.19.2.0
        , xmonad
        , xmonad-contrib
        , directory
        , filepath
        , random
    hs-source-dirs:   .
    default-language: Haskell2010
